
# Experiment 1: Data Binning and Smoothing

# Step 1: Enter the dataset
data <- c(1,1,5,5,5,5,5,8,8,10,10,10,10,12,
          14,14,14,15,15,15,15,15,15,18,18,18,18,18,
          18,18,18,20,20,20,20,20,20,20,21,21,21,21,
          25,25,25,25,25,28,28,30,30,30)

# Step 2: Equal Frequency Partitioning (Bin size = 3)
bins <- split(data, ceiling(seq_along(data)/3))

cat("Equal Frequency Bins:\n")
print(bins)

# Step 3: Smoothing by Bin Means
bin_means <- lapply(bins, function(b) rep(mean(b), length(b)))

cat("Smoothing by Bin Means:\n")
print(bin_means)

# Step 4: Smoothing by Bin Boundaries
bin_boundaries <- lapply(bins, function(b) {
  low <- min(b)
  high <- max(b)
  sapply(b, function(x) {
    if (abs(x - low) <= abs(x - high)) low else high
  })
})

cat("Smoothing by Bin Boundaries:\n")
print(bin_boundaries)

# Step 5: Plot Histogram
hist(data,
     main = "Histogram of All Electronics Prices",
     xlab = "Prices",
     ylab = "Frequency",
     col = "skyblue",
     border = "black")
