# Data
x <- c(18,18,18,20,20,20,20,20,20,20,21,21,
       21,21,25,25,25,25,25,28,28,30,30,30)

# Divide into 3 equal-frequency bins
bins <- split(sort(x), rep(1:3, each = 8))

# Bin mean smoothing
mean_smooth <- lapply(bins, function(b) rep(mean(b), length(b)))
print(mean_smooth)

# Bin boundary smoothing
boundary_smooth <- lapply(bins, function(b) {
  bounds <- range(b)
  ifelse(abs(b - bounds[1]) <= abs(b - bounds[2]),
         bounds[1], bounds[2])
})
print(boundary_smooth)

# Histogram
hist(x, breaks = 3, col = "lightblue",
     main = "Data Distribution",
     xlab = "Values")
